# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill it in. NEVER commit `.env` — it holds a
# password. `.gitignore` already excludes it.
# ---------------------------------------------------------------------------

# The Gmail account that SENDS the emails.
SMTP_USER=youraccount@gmail.com

# A Google APP PASSWORD — 16 characters, not your normal Google password.
# How to get one: SETUP-EMAIL.md, step 2. Spaces are fine, they get ignored.
SMTP_PASS=abcd efgh ijkl mnop

# Where enquiries should land. Leave blank to send them to SMTP_USER.
MAIL_TO=

# What the customer sees in the From line.
MAIL_FROM="Dubai Fine Clean" <youraccount@gmail.com>

# The site's address, so the API only accepts requests from your own site.
# Comma-separated. Add the real domain here once it's live.
SITE_ORIGIN=http://localhost:5173,http://localhost:5174

PORT=5175

# ---------------------------------------------------------------------------
# Switching away from Gmail later needs no code changes — just these two:
#   Resend   SMTP_HOST=smtp.resend.com   SMTP_PORT=465   SMTP_USER=resend
#   Brevo    SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587
#   SendGrid SMTP_HOST=smtp.sendgrid.net  SMTP_PORT=587  SMTP_USER=apikey
# ---------------------------------------------------------------------------
# SMTP_HOST=
# SMTP_PORT=
