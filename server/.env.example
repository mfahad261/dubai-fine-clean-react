# ---------------------------------------------------------------------------
# Copy this file to `server/.env` and fill in EMAIL_PASS.
#
# `.gitignore` already excludes `.env` — never commit it, never paste the
# password into a chat, an email or a screenshot. If it ever leaks, change it
# in hPanel immediately: a leaked mailbox password gets used to send spam in
# your domain's name, and then your real emails start landing in spam too.
#
# Full walkthrough: SETUP-EMAIL.md
# ---------------------------------------------------------------------------

# Hostinger's outgoing mail server. hPanel shows these under
# Emails → Manage → Configuration settings.
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465

# The FULL address of the mailbox — not just "info".
EMAIL_USER=info@dubaifineclean.com

# The MAILBOX password from hPanel → Emails → Create email account.
# This is NOT your Hostinger account password.
#
# ALWAYS WRAP IT IN DOUBLE QUOTES. In a .env file a `#` starts a comment, so
# an unquoted  EMAIL_PASS=abc#123  is silently read as just "abc" and the
# login fails with a 535 that looks exactly like a wrong password.
# Quoting also protects spaces and a trailing  #  .
EMAIL_PASS="your-mailbox-password-here"

# Where enquiries land. Leave blank to send them to EMAIL_USER.
# Point this at a Gmail you actually check if that's easier.
RECEIVER_EMAIL=info@dubaifineclean.com

# Which sites may post to the API. The live domain must be in here.
SITE_ORIGIN=http://localhost:5173,http://localhost:5174,https://dubaifineclean.com,https://www.dubaifineclean.com

# Hostinger sets PORT itself in production; this is only for local runs.
PORT=5175

NODE_ENV=development
